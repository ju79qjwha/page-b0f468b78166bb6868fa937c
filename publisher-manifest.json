dashed #d9d9d9;background:#fafafa;position:relative;margin-bottom:18px}\n.ticket::before,.ticket::after{content:\"\";position:absolute;width:14px;height:14px;background:#ffffff;border:1.5px dashed #d9d9d9;border-radius:50%;top:50%;transform:translateY(-50%)}\n.ticket::before{left:-8px}\n.ticket::after{right:-8px}\n.ticket h3{font-size:17px;font-weight:700;margin-bottom:6px}\n.ticket p{font-size:14px;color:#555}\n.ticket .tag{display:inline-block;font-size:11px;color:#ff6a00;border:1px dashed #ff6a00;padding:2px 8px;margin-bottom:10px;letter-spacing:.05em}\n\n/* 套餐表格 */\n.plans-wrap{overflow-x:auto;border:1.5px dashed #d9d9d9;background:#fff}\ntable.plans{width:100%;border-collapse:collapse;font-size:14px;min-width:720px}\ntable.plans th,table.plans td{padding:16px 14px;text-align:left;border-bottom:1px dashed #ececec;vertical-align:top}\ntable.plans thead th{background:#fff7f0;color:#ff6a00;font-weight:700;font-size:13px;letter-spacing:.05em;text-transform:uppercase;border-bottom:2px solid #ff6a00}\ntable.plans tbody tr:last-child td{border-bottom:none}\ntable.plans .pname{font-weight:700;font-size:16px;color:#1c1c1c}\ntable.plans .price{font-weight:800;color:#ff6a00;font-size:18px}\ntable.plans .feat-row td{font-size:13.5px;color:#333}\ntable.plans tr.featured{background:#fff7f0}\ntable.plans tr.featured td.pname::after{content:\" 推荐\";display:inline-block;font-size:11px;color:#fff;background:#ff6a00;padding:1px 6px;margin-left:6px;border-radius:2px;vertical-align:middle;font-weight:600}\ntable.plans .check{color:#ff6a00;font-weight:700}\ntable.plans .dash{color:#bbb}\n\n/* 步骤清单 */\n.steps{margin-top:8px}\n.step{display:grid;grid-template-columns:48px 1fr;gap:18px;padding:18px 0;border-bottom:1px dashed #ececec}\n.step:last-child{border-bottom:none}\n.step .num{font-size:26px;font-weight:800;color:#ff6a00;line-height:1}\n.step h3{font-size:16px;font-weight:700;margin-bottom:6px}\n.step p{font-size:14px;color:#555}\n.step ul{margin-top:8px;padding-left:18px;font-size:13.5px;color:#555}\n.step ul li{margin-bottom:4px}\n\n/* FAQ 双栏 */\n.faq-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}\n.faq-col h3{font-size:15px;font-weight:700;color:#ff6a00;margin-bottom:14px;padding-bottom:8px;border-bottom:1px dashed #ff6a00;letter-spacing:.05em}\n.faq{display:grid;grid-template-columns:34px 1fr;gap:12px;padding:14px 0;border-bottom:1px dashed #ececec}\n.faq:last-child{border-bottom:none}\n.faq .q{font-weight:800;color:#1c1c1c;font-size:14px}\n.faq .q::before{content:\"Q.\";color:#ff6a00;margin-right:4px}\n.faq .a{font-size:13.5px;color:#555;margin-top:6px}\n.faq .a::before{content:\"A. \";color:#ff6a00;font-weight:700}\n\n/* Footer */\nfooter{padding:48px 0 0;color:#888;font-size:13px;text-align:center}\nfooter .line{height:1px;background:#ececec;margin-bottom:32px}\n\n@media (max-width:760px){\n.hero h1{font-size:34px}\n.timeline{grid-template-columns:80px 1fr}\n.timeline::before{left:79px}\n.tl-time{padding-right:18px;font-size:11px}\n.tl-body{padding-left:24px}\n.h2{font-size:22px}\n.faq-grid{grid-template-columns:1fr}\n}\n</style><div class=\"wrap\">\n\n<header class=\"hero\" id=\"top\">\n  <div class=\"kicker\">AppleGame · 订阅使用手册</div>\n  <h1>AppleGame · 一条从<span class=\"mark\">订阅</span>到<span class=\"mark\">连接</span>的完整路径</h1>\n  <p class=\"lede\">本页整理 AppleGame 节点订阅的三档套餐、设备支持、流媒体解锁情况，以及从下单、客户端导入到日常使用的全流程，按时间顺序逐项说明。</p>\n\n  <div class=\"timeline\">\n    <div class=\"tl-row\"><div class=\"tl-time\">T0 · 选购</div><div class=\"tl-body\"><h3>选择适合的套餐</h3><p>基础版 / 旗舰版 / 团队版，按月流量、设备数量与节点等级逐级递进。</p></div></div>\n    <div class=\"tl-row\"><div class=\"tl-time\">T1 · 下单</div><div class=\"tl-body\"><h3>完成订阅支付</h3><p>订阅成功后，订阅链接与基础配置会在站内消息与注册邮箱同步推送。</p></div></div>\n    <div class=\"tl-row\"><div class=\"tl-time\">T2 · 导入</div><div class=\"tl-body\"><h3>在客户端粘贴订阅链接</h3><p>复制订阅地址，粘贴到任意支持标准协议的客户端，完成节点拉取。</p></div></div>\n    <div class=\"tl-row\"><div class=\"tl-time\">T3 · 选用</div><div class=\"tl-body\"><h3>挑选节点并连接</h3><p>根据用途选择流媒体节点或低延迟节点，启用后即可访问对应服务。</p></div></div>\n    <div class=\"tl-row\"><div class=\"tl-time\">T4 · 维护</div><div class=\"tl-body\"><h3>续费、升级与工单</h3><p>套餐到期前 7 天站内提示，旗舰版与团队版可提交工单处理使用问题。</p></div></div>\n  </div>\n\n  <div class=\"jump\">\n    <a href=\"#plans\">套餐对比</a>\n    <a href=\"#usage\">使用步骤</a>\n    <a href=\"#rules\">流量规则</a>\n    <a href=\"#faq\">常见问题</a>\n  </div>\n</header>\n\n<main>\n\n<section id=\"plans\" class=\"anchor\">\n  <h2 class=\"h2\"><span class=\"dot\">●</span> 套餐对比</h2>\n  <p class=\"sub\">三档订阅在月流量、设备数、节点池与工单响应上的差异如下。旗舰版为多数个人用户的推荐项。</p>\n\n  <div class=\"plans-wrap\">\n  <table class=\"plans\">\n    <thead>\n      <tr>\n        <th>套餐</th>\n        <th>月付价格</th>\n        <th>按年付价格</th>\n        <th>月流量</th>\n        <th>设备数</th>\n        <th>节点与功能</th>\n        <th>支持</th>\n      </tr>\n    </thead>\n    <tbody>\n      <tr>\n        <td><span class=\"pname\">基础版</span></td>\n        <td><span class=\"price\">¥15</span><br><small>/月</small></td>\n        <td>¥150 / 年</td>\n        <td>100 GB</td>\n        <td>3 台</td>\n        <td>普通线路节点池，基础流媒体解锁</td>\n        <td>常规工单</td>\n      </tr>\n      <tr class=\"feat-row\"><td>权益要点：每月 100GB 极速流量；支持 3 台设备同时在线；解锁基础流媒体；普通线路节点池</td></tr>\n\n      <tr class=\"featured\">\n        <td><span class=\"pname\">旗舰版</span></td>\n        <td><span class=\"price\">¥35</span><br><small>/月</small></td>\n        <td>¥350 / 年</td>\n        <td>300 GB</td>\n        <td>5 台</td>\n        <td>全节点原生流媒体解锁，IPLC 专线游戏加速优化</td>\n        <td>7×24 优先工单</td>\n      </tr>\n      <tr class=\"feat-row\"><td>权益要点：每月 300GB 极速流量；支持 5 台设备同时在线；全节点原生流媒体解锁；IPLC 专线游戏加速优化；7×24 优先工单支持</td></tr>\n\n      <tr>\n        <td><span class=\"pname\">团队版</span></td>\n        <td><span class=\"price\">¥85</span><br><small>/月</small></td>\n        <td>¥850 / 年</td>\n        <td>1000 GB</td>\n        <td>20 台</td>\n        <td>VIP 专属高带宽节点，支持企业定制路由</td>\n        <td>专属客户经理</td>\n      </tr>\n      <tr class=\"feat-row\"><td>权益要点：每月 1000GB 极速流量；支持 20 台设备同时在线；VIP 专属高带宽节点；支持企业定制路由；专属客户经理服务</td></tr>\n    </tbody>\n  </table>\n  </div>\n\n  <div>\n    <div class=\"ticket\">\n      <span class=\"tag\">NOTE 01</span>\n      <h3>月流量计算口径</h3>\n      <p>套餐标注的 GB 数指每月可用的出站流量额度，到期后剩余流量不结转。</p>\n    </div>\n    <div class=\"ticket\">\n      <span class=\"tag\">NOTE 02</span>\n      <h3>设备数计法</h3>\n      <p>设备数以同一订阅链接下同时在线的客户端实例计数，重复登录会占用名额。</p>\n    </div>\n    <div class=\"ticket\">\n      <span class=\"tag\">NOTE 03</span>\n      <h3>升级与降级</h3>\n      <p>可在套餐到期前提交工单申请升级；降级在下一个计费周期生效。</p>\n    </div>\n  </div>\n</section>\n\n<section id=\"usage\" class=\"anchor\">\n  <h2 class=\"h2\"><span class=\"dot\">●</span> 使用步骤</h2>\n  <p class=\"sub\">从拿到订阅链接到日常使用的标准流程。每一步对应一个具体动作，按顺序完成即可。</p>\n\n  <div class=\"steps\">\n    <div class=\"step\">\n      <div class=\"num\">01</div>\n      <div>\n        <h3>获取订阅链接</h3>\n        <p>订阅生效后，登录后台 → 我的订阅 → 复制订阅地址。建议使用浏览器复制完整 URL。</p>\n      </div>\n    </div>\n    <div class=\"step\">\n      <div class=\"num\">02</div>\n      <div>\n        <h3>在客户端导入</h3>\n        <p>打开任意支持标准协议的客户端，进入「订阅设置」或「服务器」，粘贴订阅链接并保存。</p>\n        <ul>\n          <li>iOS / macOS：导入至 Shadowrocket、Stash、Surge 等客户端</li>\n          <li>Android：导入至 Clash 系列、NekoBox 等客户端</li>\n          <li>Windows / Linux：导入至 Clash for Windows、Clash Verge 等客户端</li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"step\">\n      <div class=\"num\">03</div>\n      <div>\n        <h3>选择节点分组</h3>\n        <p>导入完成后，客户端会拉取节点分组列表，包含「流媒体」「游戏专线」「自动选择」等分组。</p>\n      </div>\n    </div>\n    <div class=\"step\">\n      <div class=\"num\">04</div>\n      <div>\n        <h3>启用连接</h3>\n        <p>选中需要的分组或具体节点，启用系统代理；首次启用会请求 VPN / 系统代理权限，请允许。</p>\n      </div>\n    </div>\n    <div class=\"step\">\n      <div class=\"num\">05</div>\n      <div>\n        <h3>验证与排错</h3>\n        <p>浏览器访问目标服务确认连通；若连接异常，可切换分组或提交工单并附上客户端日志。</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section id=\"rules\" class=\"anchor\">\n  <h2 class=\"h2\"><span class=\"dot\">●</span> 流量规则与使用提示</h2>\n  <p class=\"sub\">以下条目列出订阅周期内常见的流量使用与节点选择场景，按清单逐项核对。</p>\n\n  <div>\n    <div class=\"ticket\">\n      <span class=\"tag\">FLOW</span>\n      <h3>流媒体节点</h3>\n      <p>用于访问常见流媒体平台；不同平台对节点地区有要求，请在分组中按平台名选用。</p>\n    </div>\n    <div class=\"ticket\">\n      <span class=\"tag\">GAME</span>\n      <h3>游戏专线节点</h3>\n      <p>面向主机 / 端游玩家，提供 IPLC 专线通路，降低丢包率与延迟波动。</p>\n    </div>\n    <div class=\"ticket\">\n      <span class=\"tag\">DEVICE</span>\n      <h3>设备并发数</h3>\n      <p>同时在线的设备超过套餐上限时，新连接会被拒绝；请先下线闲置设备再启用。</p>\n    </div>\n    <div class=\"ticket\">\n      <span class=\"tag\">RENEW</span>\n      <h3>续费与到期</h3>\n      <p>套餐到期前 7 天站内提示；到期未续费，订阅链接与节点配置会被回收。</p>\n    </div>\n    <div class=\"ticket\">\n      <span class=\"tag\">REFUND</span>\n      <h3>退款范围</h3>\n      <p>订阅生效后未产生大额流量消耗、未使用优先工单的订单，可在 3 天内提交退款工单。</p>\n    </div>\n    <div class=\"ticket\">\n      <span class=\"tag\">ABUSE</span>\n      <h3>使用边界</h3>\n      <p>不得用于违反所在地区法律法规的活动；一旦发现异常使用，账号将被冻结。</p>\n    </div>\n  </div>\n</section>\n\n<section id=\"faq\" class=\"anchor\">\n  <h2 class=\"h2\"><span class=\"dot\">●</span> 常见问题</h2>\n  <p class=\"sub\">按主题分两栏整理订阅、客户端与售后三类问题，方便快速对照查找。</p>\n\n  <div class=\"faq-grid\">\n    <div class=\"faq-col\">\n      <h3>订阅与套餐</h3>\n\n      <div class=\"faq\">\n        <div class=\"q\">订阅链接在哪里查看？</div>\n        <div class=\"a\">登录 AppleGame 后台，进入「我的订阅」即可复制订阅地址；同时也会发送至注册邮箱。</div>\n      </div>\n      <div class=\"faq\">\n        <div class=\"q\">月流量用完后会断网吗？</div>\n        <div class=\"a\">月流量耗尽后当月剩余周期内将无法继续使用，到期后会自动按原套餐续费或停止服务。</div>\n      </div>\n      <div class=\"faq\">\n        <div class=\"q\">能否在套餐有效期内升级？</div>\n        <div class=\"a\">可以。在「我的订阅」提交升级工单，按差价折算剩余天数，立即生效。</div>\n      </div>\n      <div class=\"faq\">\n        <div class=\"q\">多台设备如何共享订阅？</div>\n        <div class=\"a\">使用同一订阅链接在多个客户端登录即可，设备数不超过套餐上限。</div>\n      </div>\n      <div class=\"faq\">\n        <div class=\"q\">年付与月付的区别？</div>\n        <div class=\"a\">年付以 10 个月价格获得 12 个月有效期，月付按月扣款；权益内容一致。</div>\n      </div>\n    </div>\n\n    <div class=\"faq-col\">\n      <h3>客户端与售后</h3>\n\n      <div class=\"faq\">\n        <div class=\"q\">支持哪些客户端？</div>\n        <div class=\"a\">支持 Clash 系列、Stash、Surge、Shadowrocket、NekoBox 等常见代理客户端。</div>\n      </div>\n      <div class=\"faq\">\n        <div class=\"q\">订阅导入后没有节点？</div>\n        <div class=\"a\">先检查订阅链接是否复制完整，再在客户端中点击「更新订阅」重新拉取节点。</div>\n      </div>\n      <div class=\"faq\">\n        <div class=\"q\">连接后无法访问部分网站？</div>\n        <div class=\"a\">切换到对应平台的流媒体分组或「自动选择」分组后再试；不同分组走不同节点。</div>\n      </div>\n      <div class=\"faq\">\n        <div class=\"q\">工单多久能回复？</div>\n        <div class=\"a\">基础版 24 小时内；旗舰版与团队版 7×24 优先工单，多数情况 2 小时内响应。</div>\n      </div>\n      <div class=\"faq\">\n        <div class=\"q\">申请退款需要什么材料？</div>\n        <div class=\"a\">提供订单号、未使用的流量截图与具体原因，提交至退款工单即可。</div>\n      </div>\n    </div>\n  </div>\n</section>\n\n</main>\n\n<footer>\n  <div class=\"line\"></div>\n  <p>AppleGame · 订阅使用手册</p>\n  <p>本页内容仅为订阅流程与套餐说明的整理，不构成任何性能或可用性承诺。</p>\n</footer>\n\n</div>",
